    <h1>[01-A] SOLOVERSE - DECK-BUILDER</h1>
    <div class="meta-tag">[GAME RULEBOOK] • 👥 Ages 7+, 3-6 Players • v4.0.0</div>

    <!-- INDEX JUMP MATRIX -->
    <nav class="matrix-toc-box" aria-label="Rulebook Table of Contents Matrix">
        <h2 class="matrix-toc-title">📋 RULEBOOK CONTENTS</h2>
        <ul class="matrix-toc-grid">
			<li class="matrix-item-heading">
				<a href="#compatible-expansions" class="matrix-link">COMPATIBLE EXPANSIONS</a>
			</li>
