// src/pages/index.astro
import { getCollection, render } from 'astro:content'; 

// 1. Pull your markdown collection files natively
const allGameFiles = await getCollection('games');

// 2. Your master games array (All grouped cleanly into one structure)
const gamesList = [
  {
    id: "00-ab-soloverse-crazy-8s-tutorial",
    title: "[00-AB] Soloverse - Crazy 8's Tutorial [START HERE]",
    boxColor: "#b2b2b2",
    rulesId: "00-ab-soloverse-crazy-8s-tutorial",
    cardsId: null,
    soloId: null
  },
{
    id: "01-soloverse-crazy-8s",
    title: "[01] Soloverse - Crazy 8's",
    boxColor: "#2b4cff", // 🚀 FIX: Swapped flat #0000ff for a rich royal game blue
    rulesId: "01-a-soloverse-crazy-8s-game-rules",
    cardsId: "01-b-soloverse-crazy-8s-definition-rules",
    soloId: "01-c-soloverse-crazy-8s-solo-mode-x-bot-player-rulebook"
  },
  {
    id: "02-crazy-8s-utter-chaos",
    title: "[02] Soloverse - Crazy 8's [Utter Chaos]",
    boxColor: "#10b981", // 🚀 FIX: Swapped blinding neon green for an optimized emerald vault green
    rulesId: "02-a-soloverse-crazy-8s-utter-chaos-game-rulebook",
    cardsId: "02-b-soloverse-crazy-8s-utter-chaos-definitions-rulebook",
    soloId: null
  },
  {
    id: "03-karma",
    title: "[03] Soloverse - Karma",
    boxColor: "#fff200",
    rulesId: "03-a-soloverse-karma-game-rulebook",
    cardsId: "03-b-soloverse-karma-definitions-rulebook",
    soloId: "03-c-soloverse-karma-solo-mode-x-bot-player-rulebook"
  },
  {
    id: "04-cheat",
    title: "[04] Soloverse - Cheat",
    boxColor: "#ff7f27",
    rulesId: "04-a-soloverse-cheat-game-rulebook",
    cardsId: "04-b-soloverse-cheat-definitions-rulebook",
    soloId: null
  },
  {
    id: "05-battle-solitaire",
    title: "[05] Soloverse - Battle Solitaire",
    boxColor: "#b97a56",
    rulesId: "05-a-soloverse-battle-solitaire-game-rulebook",
    cardsId: "05-b-soloverse-battle-solitaire-definitions-rulebook",
    soloId: "05-c-soloverse-battle-solitaire-solo-mode-x-bot-player-rulebook"
  },
  {
    id: "06-deck-builder",
    title: "[06] Soloverse -  Deck-Builder",
    boxColor: "#ec1c24",
    rulesId: "06-a-soloverse-deck-builder-game-rulebook",
    cardsId: "06-b-soloverse-deck-builder-definitions-rulebook",
    soloId: null
  },
  {
    id: "07-nominations",
    title: "[07] Soloverse - Nominations",
    boxColor: "#9d00ff",
    rulesId: "07-a-soloverse-nominations-game-rulebook",
    cardsId: "07-b-soloverse-nominations-definitions-rulebook",
    soloId: null
  }
];
const gamesList = [
  {
    title: "[00] Soloverse [Universal Game Notes]",
    boxColor: "#b2b2b2", // Stone box theme
    files: [
      { name: "📖 Universal Game Notes", file: "00-a-universal-game-notes", version: "4-0-0", isWebPage: true },
      { name: "🃏 Variations Rulebook", file: "00-b-variations-rulebook", version: "4-0-0", isWebPage: true },
      { name: "🕹️ Patch Notes", file: "00-c-patch-notes", version: "4-0-0", isWebPage: true }
    ]
  },
  {
    title: "[00] Soloverse [Contact Us]",
    boxColor: "#b2b2b2", 
    files: [
      { name: "Join Our Discord", file: "https://discord.gg/ShuxrtsX6s", version: "1-0-0", isWebPage: false, iconType: "discord" },
      { name: "Facebook Page", file: "https://facebook.com/soloversegame", version: "1-0-0", isWebPage: false, iconType: "facebook" },
      { name: "Instagram", file: "https://instagram.com/soloversegame", version: "1-0-0", isWebPage: false, iconType: "instagram" },
      { name: "✉ Email", file: "mailto:soloversegame@gmail.com", version: "1-0-0", isWebPage: false }
    ]
  }
];

const upcomingGames = [
  { title: "08 Soloverse - 500" },
  { title: "09 Soloverse - Poker" },
  { title: "10 Soloverse - Donkey" },
  { title: "11 Soloverse - Go Fish" },
  { title: "12 Soloverse - Sevens" },
  { title: "13 Soloverse - Snap" },
  { title: "14 Soloverse - TCG: 'Draft Mode'" },
  { title: "15 Soloverse - Dungeon Crawler"}
];


// 3. Render all components asynchronously (including Solo components)
const renderedGames = await Promise.all(
  gamesList.map(async (game) => {
    const rulesMatch = allGameFiles.find((f) => f.id === game.rulesId);
    const cardsMatch = allGameFiles.find((f) => f.id === game.cardsId);
    const soloMatch = game.soloId ? allGameFiles.find((f) => f.id === game.soloId) : null;

    const rulesRender = rulesMatch ? await render(rulesMatch) : null;
    const cardsRender = cardsMatch ? await render(cardsMatch) : null;
    const soloRender = soloMatch ? await render(soloMatch) : null;

    return {
      ...game,
      RulesComponent: rulesRender ? rulesRender.Content : null,
      CardsComponent: cardsRender ? cardsRender.Content : null,
      SoloComponent: soloRender ? soloRender.Content : null,
    };
  })
);
