            border-radius: 4px; 
        }

        /* 5. UPCOMING DEVELOPMENT PIPELINE ELEMENTS */
        .section-divider {
            width: 100%;
            background: #222533;
            padding: 15px;
            border-radius: 6px;
            text-align: center;
            font-weight: 600;
            margin: 40px 0 20px 0;
