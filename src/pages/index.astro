        .text-layer .image-container.border-poison-core, .game-panel .image-container.border-poison-core { border: 3px solid #6b21a8 !important; }
        .text-layer .image-container.border-venom-core, .game-panel .image-container.border-venom-core { border: 3px solid #dc2626 !important; }
        .text-layer .image-container.border-carbon, .game-panel .image-container.border-carbon { border: 3px solid #ea580c !important; }
        .text-layer .image-container.border-stinger-core, .game-panel .image-container.border-stinger-core { border: 3px solid #eab308 !important; }
        .text-layer .image-container.border-toxin-core, .game-panel .image-container.border-toxin-core { border: 3px solid #16a34a !important; }
        .text-layer .image-container.border-diamond, .game-panel .image-container.border-diamond { border: 3px solid #3b82f6 !important; }
        .text-layer .image-container.border-emerald, .game-panel .image-container.border-emerald { border: 3px solid #10b981; }
        .text-layer .image-container.border-redwood, .game-panel .image-container.border-redwood { border: 3px solid #5c4033 !important; }
        .text-layer .image-container.border-oak, .game-panel .image-container.border-oak { border: 3px solid #b58900 !important; }
        .text-layer .image-container.border-rose, .game-panel .image-container.border-rose { border: 3px solid #ec4899 !important; }
        .text-layer .image-container.border-amethyst, .game-panel .image-container.border-amethyst { border: 3px solid #8b5cf6 !important; }
        .text-layer .image-container.border-stone, .game-panel .image-container.border-stone { border: 3px solid #6b7280 !important; }
		
        .text-layer .card-top-section,
        .game-panel .card-top-section {
            display: flex !important;
            justify-content: space-between !important;
            align-items: flex-start !important;
            gap: 20px !important;
            width: 100% !important;
        }

        .text-layer .card-header-block,
        .game-panel .card-header-block {
            flex: 1 !important;
        }

        /* ==========================================================================
           7. UNIFIED NAVIGATION LINKS & JUMP MATRIX INTERACTION
           ========================================================================= */
        /* Meta tag positioning layout */
        .meta-tag {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 15px;
            font-weight: 600;
        }

        /* Global Navigation Control Elements */
        .platform-hub-nav {
            margin-bottom: 25px;
        }
        
        .hub-link-button,
        .hub-link-button:visited,
        .hub-link-button:link {
            display: inline-flex;
            align-items: center;
            background: var(--bg-main-box);
            border: 1px solid var(--text-divider);
            color: var(--color-link) !important;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.2s ease-in-out;
        }
        
        .hub-link-button:hover {
            background: var(--text-divider);
            color: var(--text-primary) !important;
            transform: translateY(-1px);
        }

        /* Index Jump Matrix Table Container */
        .matrix-toc-box {
            background: var(--bg-card);
            border: 1px solid var(--text-divider);
            padding: 24px;
            border-radius: 12px;
            margin: 30px 0;
        }
        
        .matrix-toc-title {
            margin: 0 0 15px 0;
            color: var(--color-link);
            font-size: 1.15rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }
        
        .matrix-toc-grid {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
                
        /* Sub-grid variant used by the contents matrix on this page only */
        .matrix-toc-sub-grid {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
            align-items: start;
        }

        /* Matrix items styled as compact cards for denser layout */
        .matrix-toc-sub-grid > li {
            background: var(--bg-main-box);
            border: 1px solid var(--text-divider);
            border-radius: 8px;
            box-shadow: none;
            display: flex; 
            overflow: hidden; 
        }

        /* Scoped link styles so other uses of .matrix-link aren't affected */
        .matrix-toc-sub-grid .matrix-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%; 
            min-height: 100%; 
            padding: 10px 12px; 
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 700;
            text-align: center;
            box-sizing: border-box; 
            transition: all 0.12s ease-in-out;
        }

        .matrix-toc-sub-grid .matrix-link:hover {
            color: var(--color-link);
            text-decoration: underline;
        }

        .matrix-link {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.15s;
        }
        
        .matrix-link:hover {
            color: var(--color-link);
            text-decoration: underline;
        }

        /* Bottom Step Jump Elements */
        .return-link-wrapper {
            text-align: right;
            margin-top: 15px;
            margin-bottom: 35px;
        }
        
        .return-link,
        .return-link:visited,
        .return-link:link {
            display: inline-flex;
            align-items: center;
            background: var(--bg-main-box);
            border: 1px solid var(--text-divider);
            color: var(--color-link) !important; 
            padding: 8px 14px; 
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 700;
            transition: all 0.2s ease-in-out;
        }

        .return-link:hover {
            background: var(--text-divider);
            color: var(--text-primary) !important;
            transform: translateY(-1px);
            text-decoration: none;
        }
    </style>

    <!-- ==================== INTERACTIVE SWITCHER SCRIPT ==================== -->
    <script is:inline>
        // Handles clicking the visual dashboard game cards
        const triggers = document.querySelectorAll('.selector-trigger');
        const panels = document.querySelectorAll('.game-panel');

        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const targetId = trigger.getAttribute('data-target');
                
                panels.forEach(panel => {
                    if (panel.id === targetId) {
                        panel.classList.remove('hidden');
                        // Smoothly scroll the user down right to their rulebook content
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } else {
                        panel.classList.add('hidden');
                    }
                });
            });
        });
    </script>

    <!-- Unified Soloverse Platform Engine: Handles Service Workers, Auto-Theme Detection, and UI Controls -->
    <script is:inline>
        (function() {
            // ==========================================
            // 1. SERVICE WORKER REGISTER & RESET CONTROLS
            // ==========================================
            if ('serviceWorker' in navigator) {
                // Register the background service worker architecture on initial load
                window.addEventListener('load', () => {
                    // FIX: Directs your app explicitly to the clean compilation route managed by your Astro config
                    navigator.serviceWorker.register('/sw.js', { scope: '/' })
                        .then(reg => {
                            console.log('Soloverse Core Sync Channel Operational:', reg.scope);
                            
                            // CLEANUP: Let the PWA check for code updates naturally instead of forcing it on every single touch event
                            if (navigator.onLine) {
                                reg.update();
                            }
                        })
                        .catch(err => console.error('Soloverse Core Sync Blocked:', err));
                });
            }

            // ==========================================
            // 2. AUTOMATED THEME EVALUATION OR OVERRIDE
            // ==========================================
            const savedTheme = localStorage.getItem('soloverse-theme');
            const devicePrefersDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            let activeTheme = 'dark'; // Base anchor default fallback

            if (savedTheme) {
                // Priority 1: Honor the explicit button selections saved in device memory
                activeTheme = savedTheme;
            } else {
                // Priority 2: Auto-detect and adopt the system mode configuration of the Android/iOS device
                activeTheme = devicePrefersDarkMode ? 'dark' : 'light';
            }

            // Mount evaluated selection instantly to prevent blinding screen flicker loops
            document.documentElement.setAttribute('data-theme', activeTheme);

            // ==========================================
            // 3. UI BUTTON CLICK RUNTIME MANAGEMENT
            // ==========================================
            window.addEventListener('DOMContentLoaded', () => {
                const themeBtn = document.getElementById('theme-toggle-btn');
                if (!themeBtn) return; // Operational guard to stop compiler crashes if the button hasn't loaded yet

                // Initialize the structural text on your shelf button to match active runtime metrics
                updateButtonUI(activeTheme);

                // Setup the mutation event tracker for deliberate player clicks
                themeBtn.addEventListener('click', () => {
                    const currentTheme = document.documentElement.getAttribute('data-theme');
                    const targetTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    
                    document.documentElement.setAttribute('data-theme', targetTheme);
                    localStorage.setItem('soloverse-theme', targetTheme);
                    updateButtonUI(targetTheme);
                });

                function updateButtonUI(theme) {
                    themeBtn.innerText = theme === 'dark' ? '☀️ Light Mode' : '🌙 Dark Mode';
                }
            });

            // ==========================================
            // 4. AUTOMATED PWA INSTALLATION INTERCEPTOR
            // ==========================================
            window.addEventListener('DOMContentLoaded', () => {
                const banner = document.getElementById('pwa-banner');
                const bodyText = document.getElementById('pwa-instructions');
                const closeCross = document.getElementById('pwa-close');
                const dismissBtn = document.getElementById('pwa-dismiss');
                const actionBtn = document.getElementById('pwa-action-btn');

                if (!banner) return; // Structural guard to prevent console errors

                // Verify if the user has already explicitly closed this banner in the past
                if (localStorage.getItem('pwa-banner-dismissed') === 'true') return;

                // Device Profiling Flags
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
                const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

                // Stop execution entirely if the player is already using the installed home screen app version
                if (isStandalone) return;

                let deferredPrompt = null;

                if (isIOS) {
                    // Scenario A: Apple iOS Platform Profiler (Safari Directions Injection)
                    bodyText.innerHTML = "Access the Soloverse platform like a native mobile app! Tap the <strong>Share</strong> button in Safari (square with an up arrow) and select <strong>Add to Home Screen</strong>.";
                    banner.style.display = 'flex';
                } else {
                    // Scenario B: Android / Google Chrome Engine Listener
                    window.addEventListener('beforeinstallprompt', (e) => {
                        // Intercept Chrome's default browser overlay popup strip
                        e.preventDefault();
                        deferredPrompt = e;

                        bodyText.innerHTML = "Install the Soloverse library layout onto your device grid for lightning-fast book rendering and full offline table support.";
                        actionBtn.style.display = 'block';
                        banner.style.display = 'flex';
                    });
                }

                // Interactive Event Triggers for Dismissing or Running Installs
                const hideBanner = () => {
                    banner.style.opacity = '0';
                    setTimeout(() => { banner.style.display = 'none'; }, 300);
                };

                closeCross.addEventListener('click', hideBanner);
                dismissBtn.addEventListener('click', () => {
                    localStorage.setItem('pwa-banner-dismissed', 'true'); // Remembers dismissal setting forever
                    hideBanner();
                });

                actionBtn.addEventListener('click', async () => {
                    if (!deferredPrompt) return;
                    hideBanner();
                    deferredPrompt.prompt(); // Fires native Google Chrome install pipeline dialog layer
                    const { outcome } = await deferredPrompt.userChoice;
                    if (outcome === 'accepted') {
                        localStorage.setItem('pwa-banner-dismissed', 'true');
                    }
                    deferredPrompt = null;
                });
            });

            // ==========================================
            // 5. MANUAL CANVAS ROTATION OVERRIDE CONTROLS
            // ==========================================
            window.addEventListener('DOMContentLoaded', () => {
                const rotateBtn = document.getElementById('rotate-view-btn');
                if (!rotateBtn) return; // Operational guard to stop console errors if button is absent

                let currentRotateState = localStorage.getItem('soloverse-rotate-lock') || 'portrait';
                document.documentElement.setAttribute('data-rotate-override', currentRotateState);

                rotateBtn.addEventListener('click', () => {
                    const activeState = document.documentElement.getAttribute('data-rotate-override');
                    const targetState = activeState === 'landscape' ? 'portrait' : 'landscape';
                    
                    document.documentElement.setAttribute('data-rotate-override', targetState);
                    localStorage.setItem('soloverse-rotate-lock', targetState);
                });
            });

        })();
    </script>

</body>
</html>