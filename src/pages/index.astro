    <!-- ==================== UNIFIED SOLOVERSE PLATFORM ARCHITECTURE ENGINE ==================== -->
    <script is:inline>
        // ==========================================
        // 1. VISUAL INTERFACE INTERACTIVE SWITCHER
        // ==========================================
        const triggers = document.querySelectorAll('.selector-trigger');
        const panels = document.querySelectorAll('.game-panel');

        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const targetId = trigger.getAttribute('data-target');
            
                panels.forEach(panel => {
                    if (panel.id === targetId) {
                        panel.classList.remove('hidden');
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } else {
                        panel.classList.add('hidden');
                    }
                });
            });
        });

        // ==========================================
        // 2. DROPDOWN LAYOUT MANAGEMENT LIFECYCLE
        // ==========================================
        document.querySelectorAll('.layout-trigger-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const targetMenu = btn.nextElementSibling;
                document.querySelectorAll('.layout-dropdown').forEach(m => {
                    if(m !== targetMenu) m.classList.add('hidden');
                });
                if (targetMenu) targetMenu.classList.remove('hidden');
            });
        });

        document.querySelectorAll('.layout-opt-btn').forEach(opt => {
            opt.addEventListener('click', () => {
                const targetPanel = opt.closest('.game-panel');
                const targetViewMode = opt.getAttribute('data-view');
                if (targetPanel) {
                    targetPanel.setAttribute('data-active-layout', targetViewMode);
                }
                const parentDropdown = opt.closest('.layout-dropdown');
                if (parentDropdown) parentDropdown.classList.add('hidden');
            });
        });

        document.addEventListener('click', () => {
            document.querySelectorAll('.layout-dropdown').forEach(m => m.classList.add('hidden'));
        });

        // ==========================================
        // 3. SERVICE WORKER LIFECYCLE & HOT SWAP SYNC
        // ==========================================
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js', { scope: '/' })
                    .then(reg => {
                        console.log('Soloverse Core Sync Channel Operational:', reg.scope);
                        if (navigator.onLine) {
                            reg.update();
                        }

                        const trackWorkerState = (worker) => {
                            worker.addEventListener('statechange', () => {
                                if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                                    const updateBanner = document.getElementById('update-sync-banner');
                                    if (updateBanner) updateBanner.style.display = 'flex';
                                }
                            });
                        };

                        if (reg.installing) trackWorkerState(reg.installing);
                        if (reg.waiting) {
                            const updateBanner = document.getElementById('update-sync-banner');
                            if (updateBanner) updateBanner.style.display = 'flex';
                        }

                        reg.addEventListener('updatefound', () => {
                            trackWorkerState(reg.installing);
                        });
                    })
                    .catch(err => console.error('Soloverse Core Sync Blocked:', err));
                });
            }

        const updateBtn = document.getElementById('update-sync-action-btn');
        if (updateBtn) {
            updateBtn.addEventListener('click', () => {
                navigator.serviceWorker.ready.then(reg => {
                    if (reg.waiting) {
                        reg.waiting.postMessage({ type: 'SKIP_WAITING' });
                    }
                    window.location.reload();
                });
            });
        }

        // ==========================================
        // 4. FIXED DARK THEME ENFORCEMENT ENGINE
        // ==========================================
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('soloverse-theme', 'dark');

        // ==========================================
        // 5. AUTOMATED PWA INSTALLATION INTERCEPTOR
        // ==========================================
        const banner = document.getElementById('pwa-banner');
        const bodyText = document.getElementById('pwa-instructions');
        const closeCross = document.getElementById('pwa-close');
        const dismissBtn = document.getElementById('pwa-dismiss');
        const actionBtn = document.getElementById('pwa-action-btn');

        // 🚀 GLOBAL SCOPING: Catch the install prompt immediately at the top level
        let deferredPrompt = null;

        window.addEventListener('beforeinstallprompt', (e) => {
            // Prevent Chrome from showing its default mini-infobar
            e.preventDefault();
            // Stash the event so we can trigger it manually
            deferredPrompt = e;
            
            // Only trigger visibility mechanics if the user hasn't explicitly dismissed it before
            const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
            if (localStorage.getItem('pwa-banner-dismissed') !== 'true' || isLocalhost) {
                if (bodyText) bodyText.innerHTML = "Install the Soloverse library layout onto your device grid for lightning-fast book rendering and full offline table support.";
                if (actionBtn) actionBtn.style.display = 'block';
                if (banner) banner.style.display = 'flex';
            }
        });

        if (banner) {
            const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        
            if (localStorage.getItem('pwa-banner-dismissed') !== 'true' || isLocalhost) {
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
                const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

                if (!isStandalone || isLocalhost) {
                    
                    // 📱 iOS Safari handling remains manual since Apple doesn't support beforeinstallprompt
                    if (isIOS) {
                        if (bodyText) bodyText.innerHTML = "Access the Soloverse platform like a native mobile app! Tap the <strong>Share</strong> button in Safari (square with an up arrow) and select <strong>Add to Home Screen</strong>.";
                        if (actionBtn) actionBtn.style.display = 'none'; // No native button for iOS
                        banner.style.display = 'flex';
                    } 
                    // 🤖 Android / Desktop Chrome Sandbox Fallback
                    else if (isLocalhost && !deferredPrompt) {
                        if (bodyText) bodyText.innerHTML = "[Dev Sandbox Mode Activated] PWA Banner rendering alignment active. Install buttons populate natively upon Android Chrome mobile engine connection channels.";
                        banner.style.display = 'flex';
                    }
                }
            }

            const hideBanner = () => {
                banner.style.opacity = '0';
                setTimeout(() => { banner.style.display = 'none'; banner.style.opacity = '1'; }, 300);
            };

            if (closeCross) closeCross.addEventListener('click', hideBanner);
            if (dismissBtn) {
                dismissBtn.addEventListener('click', () => {
                    localStorage.setItem('pwa-banner-dismissed', 'true');
                    hideBanner();
                });
            }

            if (actionBtn) {
                actionBtn.addEventListener('click', async () => {
                    if (!deferredPrompt) {
                        console.warn("Soloverse Core: Native installation prompt state is uninitialized.");
                        return;
                    }
                    hideBanner();
                    // Show the native browser install prompt overlay
                    deferredPrompt.prompt();
                    
                    // Wait for the user to respond to the prompt
                    const { outcome } = await deferredPrompt.userChoice;
                    if (outcome === 'accepted') {
                        console.log('Soloverse Core: User accepted app installation.');
                        localStorage.setItem('pwa-banner-dismissed', 'true');
                    } else {
                        console.log('Soloverse Core: User dismissed app installation.');
                    }
                    deferredPrompt = null;
                });
            }
        }
        
        // ==========================================
        // 6. CANVAS ROTATION OVERRIDE CONTROLS
        // ==========================================
        const rotateBtn = document.getElementById('rotate-view-btn');
        if (rotateBtn) {
            let currentRotateState = localStorage.getItem('soloverse-rotate-lock') || 'portrait';
            document.documentElement.setAttribute('data-rotate-override', currentRotateState);

            rotateBtn.addEventListener('click', () => {
                const activeState = document.documentElement.getAttribute('data-rotate-override');
                const targetState = activeState === 'landscape' ? 'portrait' : 'landscape';
            
                document.documentElement.setAttribute('data-rotate-override', targetState);
                localStorage.setItem('soloverse-rotate-lock', targetState);
            });
        }
    </script>

</body>
</html>