// src/pages/index.astro
import { getCollection, render } from 'astro:content'; 

// 1. Pull your markdown collection files natively
const allGameFiles = await getCollection('games');

// 2. Your master games array (All grouped cleanly into one structure)
const gamesList = [
  {
    id: "01-a-crazy-8s-tutorial",
    title: "[01-A] Soloverse - Crazy 8s [Tutorial]",
    subtitle: "Learn the Basics with a Simplified Deck",
    boxColor: "#0000ff",
    rulesId: "01-a-crazy-8s-tutorial-rules",
    cardsId: "01-a-crazy-8s-tutorial-cards",
    soloId: null
  },
  {
    id: "01-b-crazy-8s",
    title: "[01-B] Soloverse - Crazy 8s",
    subtitle: "You Know the Basics, So Add as Much Chaos to the Game as You Want.",
    boxColor: "#8cfffb",
    rulesId: "01-b-crazy-8s-rules",
    cardsId: "01-b-crazy-8s-cards",
    soloId: "01-d-crazy-8s-solo-mode-rules"
  },
  {
    id: "01-c-crazy-8s-utter-chaos",
    title: "[01-C] Crazy 8s [Utter Chaos]",
    subtitle: "Removes the Turn Structure",
    boxColor: "#aded8f",
    rulesId: "01-c-crazy-8s-utter-chaos-rules",
    cardsId: "01-c-crazy-8s-utter-chaos-cards",
    soloId: null
  },
  {
    id: "02-karma",
    title: "[02] Karma",
    subtitle: "A Hand Shedder Where There is Only 1 Loser",
    boxColor: "#0ed145",
    rulesId: "03-a-karma-rules",
    cardsId: "03-a-karma-cards",
    soloId: "03-b-karma-solo-mode-rules"
  },
  {
    id: "03-cheat",
    title: "[03] Cheat",
    subtitle: "Basically Crazy 8's But You Play Face-Down, Cheating Allowed",
    boxColor: "#fff200",
    rulesId: "04-a-cheat-rules",
    cardsId: "04-a-cheat-cards",
    soloId: null
  },
  {
    id: "04-battle-solitaire",
    title: "[04] Battle Solitaire",
    subtitle: "Solitaire, but PvP",
    boxColor: "#ff7f27",
    rulesId: "05-a-battle-solitaire-rules",
    cardsId: "05-a-battle-solitaire-cards",
    soloId: "05-b-battle-solitaire-solo-mode-rules"
  },
  {
    id: "05-deck-builder",
    title: "[05] Deck-Builder",
    subtitle: "Everyone Starts with the Same Deck, and Builds it by Buying Chaos Cards from a Common Trade Area",
    boxColor: "#b97a56",
    rulesId: "06-a-deck-builder-rules",
    cardsId: "06-a-deck-builder-cards",
    soloId: null
  },
  {
    id: "06-nominations",
    title: "[06] Nominations",
    subtitle: "Start at 1 Card, then Deal an Extra Card each Round to a Maximum of 10, then back down to 1 Card Dealt. Highest Card Wins!",
    boxColor: "#84471a",
    rulesId: "07-a-nominations-rules",
    cardsId: "07-a-nominations-cards",
    soloId: null
  },
  {
    id: "00-a-universal-game-notes",
    title: "[00-A] 📖 Universal Game Notes",
    boxColor: "#b2b2b2",
    subtitle: null,
    rulesId: "00-a-universal-game-notes",
    cardsId: null,
    soloId: null
  },
  {
    id: "00-b-full-game-contents",
    title: "[00-B] Soloverse - Full Game Contents",
    subtitle: null,
    boxColor: "#b2b2b2",
    rulesId: "00-b-full-game-contents",
    cardsId: null,
    soloId: null
  },
  {
    id: "00-c-recommended-divider-setup",
    title: "[00-C] Soloverse - Recommended Divider Setup",
    subtitle: null,
    boxColor: "#b2b2b2",
    rulesId: "00-c-recommended-divider-setup",
    cardsId: null,
    soloId: null
  },
  {
    id: "00-D-variations-rulebook",
    title: "[00-D] 🃏 Variations Rulebook",
    subtitle: null,
    boxColor: "#b2b2b2",
    rulesId: "00-d-variations-rulebook",
    cardsId: null,
    soloId: null
  },
  {
    id: "00-e-patch-notes",
    title: "[00-E] 🕹️ Patch Notes",
    subtitle: null,
    boxColor: "#b2b2b2",
    rulesId: "00-e-patch-notes",
    cardsId: null,
    soloId: null
  },
  {
    id: "00-f-contact-us",
    title: "[00-F] 📞 Contact Us",
    subtitle: "& Official Links",
    boxColor: "#b2b2b2",
    rulesId: "00-f-contact-us",
    cardsId: null,
    soloId: null
  }
];

const upcomingGames = [
  { title: "08 Soloverse - 500" },
  { title: "09 Soloverse - Poker" },
  { title: "10 Soloverse - Donkey" },
  { title: "11 Soloverse - Go Fish" },
  { title: "12 Soloverse - Sevens" },
  { title: "13 Soloverse - Snap" },
  { title: "14 Soloverse - TCG: 'Draft Mode'" },
  { title: "15 Soloverse - Dungeon Crawler"}
];


// 3. Render all components asynchronously (including Solo components)
const renderedGames = await Promise.all(
  gamesList.map(async (game) => {
    const rulesMatch = allGameFiles.find((f) => f.id === game.rulesId);
    const cardsMatch = allGameFiles.find((f) => f.id === game.cardsId);
    const soloMatch = game.soloId ? allGameFiles.find((f) => f.id === game.soloId) : null;

    const rulesRender = rulesMatch ? await render(rulesMatch) : null;
    const cardsRender = cardsMatch ? await render(cardsMatch) : null;
    const soloRender = soloMatch ? await render(soloMatch) : null;

    return {
      ...game,
      RulesComponent: rulesRender ? rulesRender.Content : null,
      CardsComponent: cardsRender ? cardsRender.Content : null,
      SoloComponent: soloRender ? soloRender.Content : null,
    };
  })
);

// 4. Pre-evaluate component availability metrics to keep the HTML template clean
const finalizedGames = renderedGames.map((game) => {
  const componentCount = [game.RulesComponent, game.CardsComponent, game.SoloComponent].filter(Boolean).length;
  const isSingleColumnDefault = componentCount <= 1;

  let initialLayout = "rules-cards";
  if (isSingleColumnDefault) {
    if (game.RulesComponent) initialLayout = "rules-only";
    else if (game.CardsComponent) initialLayout = "cards-only";
    else if (game.SoloComponent) initialLayout = "solo-only";
  }

  return {
    ...game,
    isSingleColumnDefault,
    initialLayout
  };
});
