        }

        .blueprint-card {
            background: #111217;
            border: 1px dashed #3a3f54;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }
        .blueprint-title { margin: 0 0 10px 0; font-size: 1.1rem; color: #a4a6b5; }
        .status-badge { font-size: 0.8rem; background: #2a2d3d; display: inline-block; padding: 4px 10px; border-radius: 12px; color: #b2b2b2; }

        /* JUMP LINKS & NAV STYLING */
        .return-link-wrapper { display: flex; gap: 15px; margin-top: 15px; justify-content: space-between; }
        .return-link { color: #ff4757; text-decoration: none; font-weight: 500; font-size: 0.9rem; }
        .return-link:hover { text-decoration: underline; }

        @keyframes vaultFadeIn { 
            from { opacity: 0; transform: translateY(10px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        /* ==========================================================================
           8. UNIFIED MEDIA ENGINE & VISUAL CARD GRIDS (PARENT TARGETING FIX)
           ========================================================================= */
        .text-layer .image-container,
        .game-panel .image-container {
            margin: 20px auto !important;
            padding: 12px !important;
            background: #1c1d26 !important; 
            border: 1px solid #2a2d3d !important;
            border-radius: 8px !important;
            text-align: center !important;
            max-width: 100% !important;
            display: block !important;
            flex-shrink: 0 !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5) !important;
        }

        .text-layer .image-container img,
        .game-panel .image-container img {
            max-width: 100% !important;
            max-height: 450px !important;
            width: auto !important;
            height: auto !important;
            object-fit: contain !important;
            border-radius: 6px !important;
            margin: 0 auto !important;
            display: block !important;
        }
        
        .text-layer .card-top-section .image-container img,
        .game-panel .card-top-section .image-container img {
            max-width: 150px !important;
            height: auto !important;
        }

        .image-caption {
            font-size: 0.85rem;
            color: #a4a6b5;
            margin-top: 10px;
            font-weight: 500;
            line-height: 1.4;
        }

        .image-row-container {
            display: flex !important;
            flex-wrap: wrap !important;
            gap: 15px !important;
            justify-content: center !important;
            margin: 20px 0 !important;
            width: 100% !important;
        }
