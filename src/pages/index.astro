<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Soloverse Rulebook Hub</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f1015" />

    <!-- Pure, native PWA registration. No custom code download hooks to break on mobile webviews -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .then(reg => console.log('PWA Registered:', reg.scope))
            .catch(err => console.error('PWA Failed:', err));
        });
      }
    </script>
</head>
<body>

    <!-- =============================================================== -->
    <div class="hub-logo-wrapper">
        <div class="image-container">
			<img
				src="/assets/images/layouts/soloverse-logo.png" 
				alt="Centred Image"
				loading="lazy"
			/>
		</div>
    </div>

    <header class="hero-center">

        <h1>Soloverse Rulebook Hub</h1>
            <p class="subtitle">
                <strong>What Are The Coloured Boxes?</strong> You'll notice that there are several Coloured Boxes below. 
                Please note that each Box represents part of the Soloverse, that is to say, different Games. 
                Soloverse allows you to focus on a Game Style that Suits Your Group the Most. 
                Here at Soloverse, however, we recommend beginning with [01-A] Crazy 8's [Tutorial] as that's the Game Everyone knows. 
            </p>
            <p class="subtitle">
                -------
            </p>
            <p class="subtitle">
                Once a Game has been selected, You will find 2 specific Rulebook Types split across the Screen:
            </p>
            <p class="subtitle">
                <strong>On the Left/Top:</strong> XX Soloverse - GAME NAME [Game Rulebook]. This Rulebook explains how to Play the Chosen Game.
            </p>
            <p class="subtitle">
                <strong>On the Right/Bottom:</strong> XX Soloverse - GAME NAME [Definitions Rulebook]. This Rulebook explains what each Card in the Game does.
            </p>
            <p class="subtitle">
                Having these Rulebooks split side-by-side helps in quick referencing both the Game Rules and the Card Effects while You Learn the Basics, though generally You'll need the Card Definitions more than the Game Rules once You know how to Play. 
                And since my Card Rules are Digital, I am able to alter their Definitions, both allowing me to Balance them & allow Me to add more Game Modes over Time, expanding how much fun You can have in the Soloverse! 
                Also know that each additional Game that has been added to the Game, has kept the Card Definitions as close to the Originals in Crazy 8's as possible. 
            </p>
            <p class="subtitle">
                -------
            </p>
            <p class="subtitle">
                Finally, You'll also find a "VIEW OPTIONS" Button on the Top Right of each Rulebook Title. 
                This Button will allow you to choose a variety of Rulebook View Layouts, including:
            </p>
            <p class="subtitle">
                <strong>Standard: Game Rules and Card Rules</strong> This is the Default Layout, and is the most useful for referencing both the Game Rules and the Card Definitions at the same time while learning the Game Basics.
            </p>
            <p class="subtitle">
                <strong>Only Game Rules</strong> Just the Specific Game's Rules.
            </p>
            <p class="subtitle">
                <strong>Only Card Definitions</strong> Just the Specific Game's Card Definitions. You will mostly likely end up only needing this Rulebook after You've Learned the Game Rules.
            </p>

    </header>

<!-- ==================== PART 1: THE DYNAMIC GAME CARDS GRID ==================== -->
    <div class="grid">
        {renderedGames.map((game, index) => {
            // 1. Add all your light background hex codes to this list (lowercase or uppercase)
            const lightBoxes = ["#fff200", "#8cfffb", "#aded8f", "#b97a56"];
            
            // 2. Check if the current boxColor is one of the light colors
            const isLightBox = lightBoxes.includes(game.boxColor?.toLowerCase());

            // 3. Set your styles dynamically based on the check
            const titleColor = isLightBox ? "#111216" : "#ffffff";
            const textShadowRule = isLightBox ? "none" : "0 2px 4px rgba(0,0,0,0.6)";

            return (
                <button 
                    class="game-card selector-trigger" 
                    data-target={`vault-${game.id}`}
                    style="text-align: left; width: 100%; border: none; padding: 0; cursor: pointer; display: block; overflow: hidden;"
                >
                <div class="game-header" style={`background-color: ${game.boxColor}; border-bottom: 4px solid rgba(0,0,0,0.25);`}>
                    <h2 class="game-title" style={`color: ${titleColor}; text-shadow: ${textShadowRule}; margin-bottom: 4px;`}>
                        {game.title}
                    </h2>
    
                        {/* This line checks if a description exists, and only renders it if it's not null */}
                        {game.description && (
                            <p class="game-description" style={`color: ${titleColor}; opacity: 0.85; font-size: 0.9em; margin: 0; text-shadow: ${textShadowRule};`}>
                                Description: {game.description}
                            </p>
                        )}

                        {/* This line checks if a complexity rating exists, and only renders it if it's not null */}
                        {game.complexity && (
                            <p class="game-complexity" style={`color: ${titleColor}; opacity: 0.85; font-size: 0.9em; margin: 0; text-shadow: ${textShadowRule};`}>
                                Complexity: {game.complexity}
                            </p>
                        )}

                        {/* This line checks if a age rating exists, and only renders it if it's not null */}
                        {game.ages && (
                            <p class="game-ages" style={`color: ${titleColor}; opacity: 0.85; font-size: 0.9em; margin: 0; text-shadow: ${textShadowRule};`}>
                                Ages: {game.ages}
                            </p>
                        )}

                        {/* This line checks if a player count exists, and only renders it if it's not null */}
                        {game.playercount && (
                            <p class="game-playercount" style={`color: ${titleColor}; opacity: 0.85; font-size: 0.9em; margin: 0; text-shadow: ${textShadowRule};`}>
                                Player Count: {game.playercount}
                            </p>
                        )}

                       {/* This line checks if a player count exists, and only renders it if it's not null */}
                        {game.playtime && (
                            <p class="game-playtime" style={`color: ${titleColor}; opacity: 0.85; font-size: 0.9em; margin: 0; text-shadow: ${textShadowRule};`}>
                                Playtime: {game.playtime}
                            </p>
                        )}

                    </div>
                    
                    <div class="box-contents">
                        <p style="margin: 0; padding: 10px; color: #ced4da; font-size: 0.9rem;">
                            👉 Tap to open the live Rulebook and Card Database interface.
                        </p>
                    </div>
                </button>
            );
        })}
    </div>

    <!-- ==================== NEW SPLIT-VIEW LIVE RULEBOOK PANELS ==================== -->
    <div class="vault-panels-holder" style="margin-top: 40px;">
        {finalizedGames.map((game, index) => {
            const Rules = game.RulesComponent;
            const Cards = game.CardsComponent;
            const Solo = game.SoloComponent;
            const Variation = game.VariationComponent;

            // Check metadata rules directly to see if Solo features are supported for this game card
            const hasSoloCapability = game.soloId !== null;
            const hasVariationCapability = game.variationId !== null;

            return (
                <div 
                    id={`vault-${game.id}`} 
                    class={`game-panel ${index === 0 ? '' : 'hidden'}`} 
                    data-active-layout={game.initialLayout}
                >
                   <div class="panel-accent-header" style={`border-left: 6px solid ${game.boxColor}; background: #16171e; padding: 15px; border-radius: 4px; margin-bottom: 20px;`}>
                        <h2 style="margin: 0; color: #fff;">{game.title} - Operational Database</h2>
                    
                        {!game.isSingleColumnDefault && (
                            <div style="position: relative;" class="layout-menu-container">
                                <button class="theme-btn layout-trigger-btn" style="border-color: #3a3f54;">
                                    📋 View Options
                                </button>

                                {/* Stylized Dropdown Container matching your native rules layout cleanly */}
                                <div class="layout-dropdown rules-popup-box hidden">
                                    <div style="font-size: 0.8rem; font-weight: 700; color: #a4a6b5; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; padding-left: 4px;">
                                        Select Layout Matrix
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                        {Rules && Cards && (
                                            <button class="layout-opt-btn popup-item" data-view="rules-cards">
                                                Standard: Game + Cards
                                            </button>
                                        )}
                                        {hasSoloCapability && Cards && (
                                            <button class="layout-opt-btn popup-item" data-view="solo-cards">
                                                Solo Mode + Cards
                                            </button>
                                        )}
                                        {Rules && hasSoloCapability && (
                                            <button class="layout-opt-btn popup-item" data-view="rules-solo">
                                                Game + Solo Mode
                                            </button>
                                        )}
                                        {Rules && hasVariationCapability && (
                                            <button class="layout-opt-btn popup-item" data-view="rules-variation">
                                                Game + Game Variation Rules
                                            </button>
                                        )}
                                        {Rules && (
                                            <button class="layout-opt-btn popup-item" data-view="rules-only">
                                                Only Game Rules
                                            </button>
                                        )}
                                        {Cards && (
                                            <button class="layout-opt-btn popup-item" data-view="cards-only">
                                                Only Card Definitions
                                            </button>
                                        )}
                                        {hasSoloCapability && (
                                            <button class="layout-opt-btn popup-item" data-view="solo-only">
                                                Only Solo Mode
                                            </button>
                                        )}
                                        {hasVariationCapability && (
                                            <button class="layout-opt-btn popup-item" data-view="variation-only">
                                                Only Variation Rules
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>

                    <!-- ==================== THE FIXED LAYOUT CONTAINER JUMP TRACK ==================== -->
                    <div class={`split-view flex-layout-engine ${game.isSingleColumnDefault ? 'single-column' : ''}`}>
                        {Rules && (
                            <section class="content-block view-slot-rules">
                                <h3 style={`color: ${game.boxColor}; border-bottom: 1px solid #2a2d3d; padding-bottom: 10px;`}>📜 Game Rulebook</h3>
                                <div class="text-layer">
                                    <Rules />
                                </div>
                            </section>
                        )}

                        {Cards && (
                            <section class="content-block view-slot-cards">
                                <h3 style={`color: ${game.boxColor}; border-bottom: 1px solid #2a2d3d; padding-bottom: 10px;`}>🃏 Card Definitions & Reference</h3>
                                <div class="text-layer">
                                    <Cards />
                                </div>
                            </section>
                        )}

                        {hasSoloCapability && (
                            <section class="content-block view-slot-solo">
                                <h3 style={`color: ${game.boxColor}; border-bottom: 1px solid #2a2d3d; padding-bottom: 10px;`}>🕹️ Solo Mode Rules</h3>
                                <div class="text-layer">
                                    {Solo ? <Solo /> : <p style="color: #a4a6b5; font-style: italic;">Solo mode content pending layout synchronization...</p>}
                                </div>
                            </section>
                        )}

                        <!-- FIXED: Renders the Variation content as a data field block layer directly -->
                        {hasVariationCapability && (
                            <section class="content-block view-slot-variation">
                                <h3 style={`color: ${game.boxColor}; border-bottom: 1px solid #2a2d3d; padding-bottom: 10px;`}>🃏 Game Variations</h3>
                                <div class="text-layer">
                                    {Variation ? <Variation /> : <p style="color: #a4a6b5; font-style: italic;">Parsing variation data rule tracks...</p>}
                                </div>
                            </section>
                        )}
                    </div>
                </div>
            );
        })}
    </div>

    <!-- ==================== PART 2: THE UPCOMING PIPELINE STACK ==================== -->
    <div style="margin-top: 50px;">
        <div class="section-divider">
            🛠️ In Development Blueprint Stack ({upcomingGames.length} Variants Pipeline)
        </div>

        <div class="grid">
            {upcomingGames.map((upcoming) => (
                <div class="blueprint-card">
                    <h2 class="blueprint-title">{upcoming.title}</h2>
                    <div class="status-badge">📦 Under Construction</div>
                </div>
            ))}
        </div>
    </div>

    <!-- ==================== PART 3: THE SMART HIGH-VISIBILITY PWA INSTALLATION OVERLAY ==================== -->
    <div id="pwa-banner" class="pwa-install-banner" style="display: none; position: fixed; top: 15px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 500px; z-index: 9999; background: #16171e; border: 2px solid #3b82f6; box-shadow: 0 15px 40px rgba(0,0,0,0.8); border-radius: 12px; flex-direction: column; padding: 15px;">
        <div class="pwa-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div class="pwa-title" style="font-weight: 700; color: #fff; font-size: 1.05rem;">📱 Add Soloverse to Home Screen</div>
            <button id="pwa-close" class="pwa-close-btn" style="background: none; border: none; color: #a4a6b5; font-size: 1.5rem; cursor: pointer; line-height: 1;" aria-label="Close popup">×</button>
        </div>
        <div id="pwa-instructions" class="pwa-body" style="font-size: 0.88rem; color: #ced4da; line-height: 1.4; margin-bottom: 12px;">
            <!-- Content will be auto-generated by your script layer -->
        </div>
        <div class="pwa-action-row" style="display: flex; justify-content: flex-end; gap: 10px;">
            <button id="pwa-dismiss" class="theme-btn" style="padding: 6px 12px; font-size: 0.8rem; background: transparent; border-color: #2a2d3d;">Not Now</button>
            <button id="pwa-action-btn" class="theme-btn" style="padding: 6px 12px; font-size: 0.8rem; background: #3b82f6; color: #fff; border: none; display: none;">Install App</button>
        </div>
    </div>

    <!-- ==================== PART 3B: PLATFORM HOTFIX UPDATE CHANNEL NOTIFIER ==================== -->
    <div id="update-sync-banner" class="pwa-install-banner" style="display: none; position: fixed; top: 15px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 500px; z-index: 10000; background: #11121a; border: 2px solid #eab308; box-shadow: 0 15px 40px rgba(0,0,0,0.8); border-radius: 12px; flex-direction: column; padding: 15px;">
        <div class="pwa-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div class="pwa-title" style="font-weight: 700; color: #eab308; font-size: 1.05rem;">⚡ Table Blueprint Changes Ready</div>
        </div>
        <div class="pwa-body" style="font-size: 0.88rem; color: #ced4da; line-height: 1.4; margin-bottom: 12px;">
            New game balancing mechanics, variations, or card layout optimizations have been updated on the live server environment.
        </div>
        <div class="pwa-action-row" style="display: flex; justify-content: flex-end;">
            <button id="update-sync-action-btn" class="theme-btn" style="padding: 8px 16px; font-size: 0.85rem; background: #eab308; color: #111216; border: none;">Sync Assets Offline</button>
        </div>
    </div>

    <!-- ==================== UNIFIED SOLOVERSE PLATFORM ARCHITECTURE ENGINE ==================== -->
    <script is:inline>
        // ==========================================
        // 1. VISUAL INTERFACE INTERACTIVE SWITCHER
        // ==========================================
        const triggers = document.querySelectorAll('.selector-trigger');
        const panels = document.querySelectorAll('.game-panel');

        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const targetId = trigger.getAttribute('data-target');
            
                panels.forEach(panel => {
                    if (panel.id === targetId) {
                        panel.classList.remove('hidden');
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } else {
                        panel.classList.add('hidden');
                    }
                });
            });
        });

        // ==========================================
        // 2. DROPDOWN LAYOUT MANAGEMENT LIFECYCLE
        // ==========================================
        document.querySelectorAll('.layout-trigger-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const targetMenu = btn.nextElementSibling;
                document.querySelectorAll('.layout-dropdown').forEach(m => {
                    if(m !== targetMenu) m.classList.add('hidden');
                });
                if (targetMenu) targetMenu.classList.remove('hidden');
            });
        });

        document.querySelectorAll('.layout-opt-btn').forEach(opt => {
            opt.addEventListener('click', () => {
                const targetPanel = opt.closest('.game-panel');
                const targetViewMode = opt.getAttribute('data-view');
                if (targetPanel) {
                    targetPanel.setAttribute('data-active-layout', targetViewMode);
                }
                const parentDropdown = opt.closest('.layout-dropdown');
                if (parentDropdown) parentDropdown.classList.add('hidden');
            });
        });

        document.addEventListener('click', () => {
            document.querySelectorAll('.layout-dropdown').forEach(m => m.classList.add('hidden'));
        });

        // ==========================================
        // 3. SERVICE WORKER LIFECYCLE & HOT SWAP SYNC
        // ==========================================
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js', { scope: '/' })
                    .then(reg => {
                        console.log('Soloverse Core Sync Channel Operational:', reg.scope);
                        if (navigator.onLine) {
                            reg.update();
                        }

                        const trackWorkerState = (worker) => {
                            worker.addEventListener('statechange', () => {
                                if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                                    const updateBanner = document.getElementById('update-sync-banner');
                                    if (updateBanner) updateBanner.style.display = 'flex';
                                }
                            });
                        };

                        if (reg.installing) trackWorkerState(reg.installing);
                        if (reg.waiting) {
                            const updateBanner = document.getElementById('update-sync-banner');
                            if (updateBanner) updateBanner.style.display = 'flex';
                        }

                        reg.addEventListener('updatefound', () => {
                            trackWorkerState(reg.installing);
                        });
                    })
                    .catch(err => console.error('Soloverse Core Sync Blocked:', err));
                });
            }

        const updateBtn = document.getElementById('update-sync-action-btn');
        if (updateBtn) {
            updateBtn.addEventListener('click', () => {
                navigator.serviceWorker.ready.then(reg => {
                    if (reg.waiting) {
                        reg.waiting.postMessage({ type: 'SKIP_WAITING' });
                    }
                    window.location.reload();
                });
            });
        }

        // ==========================================
        // 4. FIXED DARK THEME ENFORCEMENT ENGINE
        // ==========================================
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('soloverse-theme', 'dark');

        // ==========================================
        // 5. AUTOMATED PWA INSTALLATION INTERCEPTOR
        // ==========================================
        const banner = document.getElementById('pwa-banner');
        const bodyText = document.getElementById('pwa-instructions');
        const closeCross = document.getElementById('pwa-close');
        const dismissBtn = document.getElementById('pwa-dismiss');
        const actionBtn = document.getElementById('pwa-action-btn');

        // 🚀 GLOBAL SCOPING: Catch the install prompt immediately at the top level
        let deferredPrompt = null;

        window.addEventListener('beforeinstallprompt', (e) => {
            // Prevent Chrome from showing its default mini-infobar
            e.preventDefault();
            // Stash the event so we can trigger it manually
            deferredPrompt = e;
            
            // Only trigger visibility mechanics if the user hasn't explicitly dismissed it before
            const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
            if (localStorage.getItem('pwa-banner-dismissed') !== 'true' || isLocalhost) {
                if (bodyText) bodyText.innerHTML = "Install the Soloverse library layout onto your device grid for lightning-fast book rendering and full offline table support.";
                if (actionBtn) actionBtn.style.display = 'block';
                if (banner) banner.style.display = 'flex';
            }
        });

        if (banner) {
            const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        
            if (localStorage.getItem('pwa-banner-dismissed') !== 'true' || isLocalhost) {
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
                const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

                if (!isStandalone || isLocalhost) {
                    
                    // 📱 iOS Safari handling remains manual since Apple doesn't support beforeinstallprompt
                    if (isIOS) {
                        if (bodyText) bodyText.innerHTML = "Access the Soloverse platform like a native mobile app! Tap the <strong>Share</strong> button in Safari (square with an up arrow) and select <strong>Add to Home Screen</strong>.";
                        if (actionBtn) actionBtn.style.display = 'none'; // No native button for iOS
                        banner.style.display = 'flex';
                    } 
                    // 🤖 Android / Desktop Chrome Sandbox Fallback
                    else if (isLocalhost && !deferredPrompt) {
                        if (bodyText) bodyText.innerHTML = "[Dev Sandbox Mode Activated] PWA Banner rendering alignment active. Install buttons populate natively upon Android Chrome mobile engine connection channels.";
                        banner.style.display = 'flex';
                    }
                }
            }

            const hideBanner = () => {
                banner.style.opacity = '0';
                setTimeout(() => { banner.style.display = 'none'; banner.style.opacity = '1'; }, 300);
            };

            if (closeCross) closeCross.addEventListener('click', hideBanner);
            if (dismissBtn) {
                dismissBtn.addEventListener('click', () => {
                    localStorage.setItem('pwa-banner-dismissed', 'true');
                    hideBanner();
                });
            }

            if (actionBtn) {
                actionBtn.addEventListener('click', async () => {
                    if (!deferredPrompt) {
                        console.warn("Soloverse Core: Native installation prompt state is uninitialized.");
                        return;
                    }
                    hideBanner();
                    // Show the native browser install prompt overlay
                    deferredPrompt.prompt();
                    
                    // Wait for the user to respond to the prompt
                    const { outcome } = await deferredPrompt.userChoice;
                    if (outcome === 'accepted') {
                        console.log('Soloverse Core: User accepted app installation.');
                        localStorage.setItem('pwa-banner-dismissed', 'true');
                    } else {
                        console.log('Soloverse Core: User dismissed app installation.');
                    }
                    deferredPrompt = null;
                });
            }
        }
        
        // ==========================================
        // 6. CANVAS ROTATION OVERRIDE CONTROLS
        // ==========================================
        const rotateBtn = document.getElementById('rotate-view-btn');
        if (rotateBtn) {
            let currentRotateState = localStorage.getItem('soloverse-rotate-lock') || 'portrait';
            document.documentElement.setAttribute('data-rotate-override', currentRotateState);

            rotateBtn.addEventListener('click', () => {
                const activeState = document.documentElement.getAttribute('data-rotate-override');
                const targetState = activeState === 'landscape' ? 'portrait' : 'landscape';
            
                document.documentElement.setAttribute('data-rotate-override', targetState);
                localStorage.setItem('soloverse-rotate-lock', targetState);
            });
        }
    </script>

</body>
</html>